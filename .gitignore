# Python
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and flags
*.log
*.lock
pause.flag
results/**/train_log_*.txt

# Raw and processed datasets — never commit large archives/caches
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Binary model checkpoints and weights — too big for GitHub
*.pt
*.pth
*.bin
*.ckpt
*.onnx

# Binary data arrays and cache
*.npy
*.npz
*.mat
*.p

# Temporary files and large line-delimited stream manifests
*.tmp
*.jsonl

# Large derived CSVs (regenerable from raw data)
data/processed/annotated_scenario36_with_predictions.csv
