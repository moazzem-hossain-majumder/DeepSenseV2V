# Python
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and flags
*.log
pause.flag

# Raw dataset files — never commit (large archives, licensed)
data/raw/scenario36/
data/raw/*.p
data/raw/*.csv
data/raw/*.mat
data/raw/*.zip
data/raw/*.tar.gz

# Large binary model files — too big for GitHub
results/checkpoints/*.pt
results/checkpoints/*.pth
results/checkpoints/*.bin

# Large processed data binaries
data/processed/*.pt
data/processed/*.npy

# Generic binary formats
*.mat
*.onnx
*.ckpt

# Keep these result files (tables, plots, JSONs, checklist)
!results/ablation_table.csv
